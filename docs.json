  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "interactive",
      "proxy": true,
      "credentials": false
    },
    "params": {
      "expanded": "closed"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "autogenerate": true
    }
  },
  "search": {
    "prompt": "Search RevoEngine concepts, guides, SDK examples, and API operations"
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "toc"
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:title": "RevoEngine Documentation",
      "og:description": "Build and operate secure low-code applications, APIs, automation, and AI agents."
    }
  },
  "redirects": [
    {
      "source": "/mcp",
      "destination": "/developers/mcp-overview"
    },
    {
      "source": "/developers/mcp",
      "destination": "/developers/mcp-overview"
    },
    {
      "source": "/run-api/:slug*",
      "destination": "/developers/endpoint-runtime"
    },
    {
      "source": "/solutions/endpoints",
      "destination": "/operate/endpoints"
    },
    {
      "source": "/solutions/databases",
      "destination": "/operate/databases"
    },
    {
      "source": "/solutions/files",
      "destination": "/operate/storage"
    },
    {
      "source": "/solutions/jobs",
      "destination": "/operate/automation"
    },
    {
      "source": "/solutions/realtime",
      "destination": "/operate/realtime"
    },
    {
      "source": "/features/ai-assistant",
      "destination": "/ai/assistant"
    },
    {
      "source": "/features/events",
      "destination": "/operate/automation"
    },
    {
      "source": "/features/schedule",
      "destination": "/operate/automation"
    },
    {
      "source": "/resources",
      "destination": "/platform/overview"
    }
  ]
